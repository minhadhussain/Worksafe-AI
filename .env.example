# Browser-facing URLs. Rebuild web after changing NEXT_PUBLIC_* values.
# The Docker HTTPS gateway listens on https://localhost:8443.
NEXT_PUBLIC_API_URL=https://localhost:8443/v1
NEXT_PUBLIC_WS_URL=wss://localhost:8443/ws
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:3000
NEXT_PUBLIC_WORKER_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CAMERA_01_SOURCE=/demo/cam-01-compliant.mp4
NEXT_PUBLIC_CAMERA_02_SOURCE=/demo/cam-02-violation.mp4
NEXT_PUBLIC_WORKER_ID=W-001
# Browser WebSockets cannot send Authorization headers, so the MVP worker token
# is passed in the socket URL and visible to the browser bundle.
NEXT_PUBLIC_WORKER_TOKEN=dev_device_worker_001

# Used by the Next.js server for health checks. Compose overrides the hostname.
API_INTERNAL_URL=http://localhost:8000

APP_ENV=development
LOG_LEVEL=INFO

# Dedicated admin login route. The passcode is verified on the Next.js server
# and the login attempt is recorded to Supabase before redirecting to /dashboard.
ADMIN_LOGIN_IDENTIFIER=ADMIN1
ADMIN_LOGIN_PASSCODE=replace-with-admin-passcode
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_LOGIN_TABLE=admin_login_events

# JSON array of exact browser origins; add your HTTPS tunnel origin for demos.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://localhost:8443","https://127.0.0.1:8443"]

# Place the trained Roboflow/YOLOv8 weights at the path below.
VISION_MODEL_WEIGHTS=apps/api/ml_models/vigil-os-ppe.pt
VISION_CONFIDENCE_THRESHOLD=0.25

# Host development URL. Compose uses redis://redis:6379/0 internally.
REDIS_URL=redis://localhost:6379/0

# MVP worker authentication and last-known-state retention.
WORKER_API_TOKENS=["dev_device_worker_001"]
WORKER_TELEMETRY_TTL_SECONDS=30

# MVP hardware node authentication and last-known-state retention.
HARDWARE_API_TOKENS=["dev_device_machine_001"]
HARDWARE_TELEMETRY_TTL_SECONDS=60

# Reserved for Supabase PostgreSQL integration in a later phase.
# Phase 1 does not open a database connection or require credentials.
DATABASE_URL=
