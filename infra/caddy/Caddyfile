{
    local_certs
}

http://localhost:8080, http://127.0.0.1:8080, http://workvision.localhost:8080 {
    redir https://localhost:8443{uri}
}

https://localhost:8443, https://127.0.0.1:8443, https://workvision.localhost:8443 {
    tls internal
    encode zstd gzip

    @api path /health /health/* /v1 /v1/* /docs /docs/* /openapi.json /redoc /redoc/* /ws /ws/*
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
